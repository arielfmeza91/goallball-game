<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>GoalballSonoro</AssemblyName><ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>2.0.0</Version><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Goalball.Core/Goalball.Core.csproj"/><PackageReference Include="NAudio" Version="2.2.1"/></ItemGroup>
  <ItemGroup><Content Include="../../assets-native/*.wav" Link="sonidos/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
</Project>
